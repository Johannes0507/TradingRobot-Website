---
/**
 * Architecture — "連接有範圍，執行有規則"
 *
 * Editorial indexed-grid (left) + spec-sheet cards (right), bound by a
 * sticky-scroll: the active left step couples to the front 3D-swap card.
 */
import StickyScrollStage from './islands/StickyScrollStage.tsx';

const steps = [
  {
    n: '01',
    title: '只開必要的權限',
    desc: 'API 金鑰只開啟必要權限，以及餘額查閱權限，用來確認資金狀態。提款、轉帳、交易與帳戶設定修改都不開；系統也會在每次送出新單前強制檢查。',
    tag: '最小權限 API',
    href: '/guides/bitfinex-api-setup',
  },
  {
    n: '02',
    title: '系統只執行策略指令',
    desc: '穩穩控不移動你的資產，而是依照你設定的規則，定期比對市場狀態、可用餘額與安全限制；符合條件時，才透過 API 送出授權範圍內的指令。',
    tag: '策略指令層',
    href: 'https://support.bitfinex.com/hc/en-us/articles/360023366314-What-is-the-Bitfinex-API',
  },
  {
    n: '03',
    title: '安全邊界仍在來源平台',
    desc: '你的資產仍留在 Bitfinex 帳號中。Bitfinex 自 2012 年營運，服務專業交易者與機構用戶；2026 年取得國家級合規監管牌照 (DASP)，也曾公開鏈上錢包與儲備資訊。穩穩控只做外層策略控制，安全邊界仍在來源平台。',
    tag: 'Bitfinex DASP 2026',
    href: 'https://blog.bitfinex.com/announcements/bitfinex-secures-licence-in-el-salvador/',
  },
];
---

<section id="security" class="arch-section">
  <div class="arch-wrap">
    <div class="arch-left">
      <header class="arch-header">
        <h2 class="eyebrow text-xs font-mono font-semibold text-mute uppercase tracking-[0.14em] mb-5">
          安全 <span class="text-mute-soft normal-case"> 三道約束，分開下單與動用資產</span>
        </h2>
        <p class="font-display font-semibold text-ink text-2xl lg:text-3xl leading-[1.25] tracking-tight">
          連接有範圍，執行有規則
        </p>
      </header>

      {steps.map((s, i) => {
        const external = s.href.startsWith('http');
        return (
          <article class="ss-step" data-frame={i.toString()}>
            <div class="ss-row">
              <div class="ss-idx">{s.n}</div>
              <div class="ss-body">
                <h3>{s.title}</h3>
                <p>{s.desc}</p>
                <a
                  class="ss-meta"
                  href={s.href}
                  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <span class="ss-meta-txt">{s.tag}</span>
                  <span class="ss-meta-rule" aria-hidden="true" />
                  {external ? (
                    <svg class="ss-meta-arrow" width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                      <path d="M3.5 8.5 8.5 3.5M5 3.5h3.5v3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  ) : (
                    <svg class="ss-meta-arrow" width="13" height="11" viewBox="0 0 13 12" fill="none" aria-hidden="true">
                      <path d="M2 6h8M7 3l3 3-3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <div class="arch-right">
      <div class="ss-stage">
        <!-- Card 0 · API SCOPE -->
        <div class="swap-card" data-card="0">
          <div class="spec-head">
            <span class="spec-idx">01</span>
            <span class="spec-label">API Scope</span>
          </div>
          <div class="spec-rows">
            <div class="spec-row"><span class="spec-k">查詢餘額</span><span class="spec-v spec-v--on">開啟</span></div>
            <div class="spec-row"><span class="spec-k">提供資金報價</span><span class="spec-v spec-v--on">開啟</span></div>
            <div class="spec-rule" aria-hidden="true"></div>
            <div class="spec-row"><span class="spec-k">提款</span><span class="spec-v spec-v--off">關閉</span></div>
            <div class="spec-row"><span class="spec-k">轉帳</span><span class="spec-v spec-v--off">關閉</span></div>
            <div class="spec-row"><span class="spec-k">交易</span><span class="spec-v spec-v--off">關閉</span></div>
            <div class="spec-row"><span class="spec-k">修改設定</span><span class="spec-v spec-v--off">關閉</span></div>
          </div>
          <div class="spec-foot">最小權限原則</div>
        </div>

        <!-- Card 1 · STRATEGY ENGINE -->
        <div class="swap-card" data-card="1">
          <div class="spec-head">
            <span class="spec-idx">02</span>
            <span class="spec-label">Strategy Engine</span>
          </div>
          <div class="spec-rows">
            <div class="spec-row"><span class="spec-k">市場狀態</span><span class="spec-v spec-v--on">符合</span></div>
            <div class="spec-row"><span class="spec-k">可用餘額</span><span class="spec-v spec-v--on">充足</span></div>
            <div class="spec-row"><span class="spec-k">安全限制</span><span class="spec-v spec-v--on">通過</span></div>
            <div class="spec-rule spec-rule--label" aria-hidden="true"><span>規則比對</span></div>
            <div class="spec-out"><span class="spec-out-arrow" aria-hidden="true">→</span>送出授權範圍內的指令</div>
          </div>
          <div class="spec-foot">資產零移動</div>
        </div>

        <!-- Card 2 · SECURITY BOUNDARY (中間 hairline = 邊界) -->
        <div class="swap-card" data-card="2">
          <div class="spec-head">
            <span class="spec-idx">03</span>
            <span class="spec-label">Security Boundary</span>
          </div>
          <div class="spec-rows">
            <div class="spec-row"><span class="spec-k">策略控制層</span><span class="spec-v">穩穩控 · 外層</span></div>
            <div class="spec-rule spec-rule--label"><span>邊界</span></div>
            <div class="spec-row"><span class="spec-k">資產保管</span><span class="spec-v spec-v--on">Bitfinex</span></div>
            <div class="spec-note">你的資金始終留在 Bitfinex 帳號</div>
          </div>
          <div class="spec-foot spec-foot--data">營運自 2012 · DASP 2026 · 公開鏈上儲備</div>
        </div>
      </div>
    </div>
  </div>

  <StickyScrollStage client:load skewAmount={0} />
</section>

<style>
  .arch-section {
    background: var(--color-surface);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    padding: 0;
  }
  .arch-wrap {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .arch-left { padding: 96px 0 96px; }
  .arch-header { margin-bottom: 32px; }

  /* ── Indexed editorial grid (left column) ───────────────────────── */
  .ss-step {
    min-height: clamp(360px, 52vh, 520px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 28px 0;
    border-top: 1px solid var(--color-line);
  }
  .ss-step:first-of-type { border-top: none; }
  .ss-row { display: grid; grid-template-columns: 64px 1fr; }
  .ss-idx {
    font-family: var(--font-mono);
    font-size: 30px; font-weight: 700; line-height: 1; letter-spacing: -0.02em;
    color: var(--color-mute-soft); opacity: 0.45;
    transition: color var(--dur-base) var(--ease-out-expo), opacity var(--dur-base) var(--ease-out-expo);
  }
  .ss-body {
    border-left: 1px solid var(--color-line-soft);
    padding-left: 28px;
    transition: border-color var(--dur-base) var(--ease-out-expo);
  }
  .ss-body h3 {
    font-family: var(--font-display);
    font-size: clamp(20px, 1.8vw, 23px);
    line-height: 1.25;
    letter-spacing: -0.025em;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 14px;
    text-wrap: balance;
  }
  .ss-body p {
    color: var(--color-ink-soft);
    font-size: 16px;
    line-height: 1.625;
    max-width: 420px;
    margin: 0 0 22px;
    line-break: strict;
  }
  /* right-aligned meta with em-rule */
  .ss-meta {
    display: flex; align-items: center; gap: 12px;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 11.5px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--color-mute);
    transition: color var(--dur-micro) var(--ease-standard);
  }
  .ss-meta-txt { flex-shrink: 0; }
  .ss-meta-rule {
    flex: 1; height: 1px; background: var(--color-line);
    transition: background var(--dur-micro) var(--ease-standard);
  }
  .ss-meta-arrow { flex-shrink: 0; display: block; transition: transform var(--dur-micro) var(--ease-standard); }
  .ss-meta:hover { color: var(--color-brand); }
  .ss-meta:hover .ss-meta-rule { background: color-mix(in srgb, var(--color-brand) 40%, transparent); }
  .ss-meta:hover .ss-meta-arrow { transform: translate(2px, -2px); }
  .ss-meta:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 3px; }

  /* active-step coupling (toggled by StickyScrollStage island) */
  .ss-step.is-active .ss-idx { color: var(--color-ink); opacity: 1; }
  .ss-step.is-active .ss-body { border-left-color: var(--color-brand); }

  .arch-right {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ss-stage {
    position: relative;
    width: 100%;
    max-width: 460px;
    aspect-ratio: 1;
    perspective: 1400px;
    transform-style: preserve-3d;
  }

  /* ── 3D stacked cards (reactbits CardSwap-inspired) ─────────────── */
  .swap-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 344px;
    height: 320px;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 10px;
    padding: 22px 24px;
    box-shadow:
      0 26px 64px -30px rgba(10, 37, 64, 0.28),
      0 6px 16px -6px rgba(10, 37, 64, 0.07);
    transform-style: preserve-3d;
    backface-visibility: hidden;
    will-change: transform;
    /* GSAP sets translate3d + skewY at runtime; initial position is hidden
       until GSAP places it (avoids a flash of stacked-on-origin layout). */
    visibility: hidden;
  }
  .swap-card[style] {
    visibility: visible;
  }

  /* ── Spec-sheet card grammar (shared, editorial) ────────────────── */
  .spec-head {
    display: flex; align-items: baseline; justify-content: space-between;
    padding-bottom: 12px; margin-bottom: 12px;
    border-bottom: 1px solid var(--color-line);
  }
  .spec-idx {
    font-family: var(--font-mono); font-size: 30px; font-weight: 700;
    line-height: 1; color: var(--color-ink); letter-spacing: -0.02em;
  }
  .spec-label {
    font-family: var(--font-mono); font-size: 10.5px; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-mute-soft);
  }
  .spec-rows { flex: 1; display: flex; flex-direction: column; }
  .spec-row {
    display: flex; align-items: center; justify-content: space-between;
    padding: 6px 0; font-size: 13.5px;
  }
  .spec-k {
    font-family: var(--font-display);
    font-weight: 500; font-size: 14px; letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .spec-v {
    font-family: var(--font-mono); font-size: 12px;
    color: var(--color-mute-soft); letter-spacing: 0.02em;
    display: inline-flex; align-items: center; gap: 7px;
  }
  .spec-v--on { color: var(--color-ink); }
  .spec-v--on::before {
    content: ''; width: 6px; height: 6px; border-radius: 50%;
    background: var(--color-mint); flex-shrink: 0;
  }
  .spec-v--off::before { content: '—'; color: var(--color-mute-soft); }

  /* structural hairlines */
  .spec-rule { height: 1px; background: var(--color-line-soft); margin: 8px 0; }
  .spec-rule--label {
    height: auto; background: none; margin: 12px 0;
    display: flex; align-items: center; gap: 10px;
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--color-mute);
  }
  .spec-rule--label span { flex-shrink: 0; }
  .spec-rule--label::before, .spec-rule--label::after {
    content: ''; flex: 1; height: 1px; background: var(--color-line);
  }

  /* emphasized output row (card 02) — flush-left, aligns with the keys above */
  .spec-out {
    display: flex; align-items: center; gap: 9px;
    margin-top: 8px; padding: 2px 0;
    color: var(--color-brand);
    font-family: var(--font-display); font-weight: 600;
    font-size: 14.5px; letter-spacing: -0.01em;
  }
  .spec-out-arrow { font-family: var(--font-mono); font-weight: 400; }

  .spec-note {
    font-family: var(--font-display); font-size: 12.5px;
    color: var(--color-mute); margin-top: 4px; padding: 2px 0;
  }

  .spec-foot {
    margin-top: 14px; padding-top: 12px;
    border-top: 1px solid var(--color-line);
    font-family: var(--font-mono); font-weight: 600;
    font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-mute);
  }
  .spec-foot--data { letter-spacing: 0.05em; text-transform: none; color: var(--color-mute-soft); }

  /* ── Responsive ─────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .arch-wrap {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .arch-left { padding: 56px 0 56px; }
    .ss-step { min-height: auto; padding: 24px 0; }
    .ss-row { grid-template-columns: 46px 1fr; }
    .ss-body { padding-left: 18px; }
    .arch-right {
      position: relative;
      height: auto;
      padding: 20px 0 60px;
    }
    .ss-stage { aspect-ratio: 1.2; max-width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    /* GSAP respects user motion prefs via its own duration:0 in the island;
       this rule is a fallback if cards somehow render without GSAP. */
    .swap-card { transform: none !important; }
  }
</style>
