---
/**
 * Architecture — "你的錢，我們從來沒碰過。"
 *
 * Sticky-scroll pattern (v2 Lumen Light reference): left column scrolls
 * with multiple text panels, right column has a sticky stage where visual
 * frames cross-fade based on which left panel is currently in view.
 */
import StickyScrollStage from './islands/StickyScrollStage.tsx';

const steps = [
  {
    n: '01',
    title: 'API 權限只勾 Funding',
    desc: '你在 Bitfinex 生成 API Key 時，只勾 Funding scope，不勾 Withdrawals 與 Trading。Bitfinex 端強制執行，LendAuto 後端即使有 key 也無法繞過。',
    tag: 'scope: funding_only',
  },
  {
    n: '02',
    title: 'AES-256-GCM 加密儲存',
    desc: 'API Key 在資料庫是密文，envelope encryption + per-tenant key。LendAuto 工程師也看不到明文。',
    tag: 'AES-256-GCM · envelope',
  },
  {
    n: '03',
    title: '資金永遠在你的 Bitfinex 帳號',
    desc: 'LendAuto 是掛單代理人，不是 custodian。我們不開錢包、不持有資產、不經手任何提款。',
    tag: 'custody: self',
  },
  {
    n: '04',
    title: '績效樣張無修圖',
    desc: '我們在 demo 帳號跑 LendAuto 30 日的實際表現截圖，無美化、無修圖、無剪輯。累積時間後會增加更多時間範圍。',
    tag: 'transparency',
  },
];
---

<section id="security" class="arch-section">
  <div class="arch-wrap">
    <div class="arch-left">
      <header class="arch-header">
        <div class="eyebrow text-xs font-mono font-semibold text-mute uppercase tracking-wider mb-4">
          架構與安全
        </div>
        <h2 class="arch-title">你的錢，<br />我們從來<br />沒碰過。</h2>
        <p class="arch-lede">
          把自動化交給我們，把保管留給你自己。三個技術約束讓「我們即使想拿也拿不到」，加上實打實的績效透明。
        </p>
      </header>

      {steps.map((s, i) => (
        <article class="ss-step" data-frame={i.toString()}>
          <div class="stepnum">Step {s.n}</div>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
          <div class="arch-tag">{s.tag}</div>
        </article>
      ))}
    </div>

    <div class="arch-right">
      <div class="ss-stage">
        <!-- Frame 0: API scope toggle -->
        <div class="ss-frame ss-frame-0 is-active">
          <div class="arch-frame-mock">
            <div class="arch-mock-head">Bitfinex · Generate API Key</div>
            <div class="arch-perm">
              <div class="arch-perm-row arch-perm-on">
                <span class="arch-perm-tick" aria-hidden="true"></span>
                <span class="arch-perm-name">Funding · Provide funding</span>
              </div>
              <div class="arch-perm-row arch-perm-off">
                <span class="arch-perm-x" aria-hidden="true"></span>
                <span class="arch-perm-name">Withdrawals</span>
              </div>
              <div class="arch-perm-row arch-perm-off">
                <span class="arch-perm-x" aria-hidden="true"></span>
                <span class="arch-perm-name">Trading · Orders</span>
              </div>
              <div class="arch-perm-row arch-perm-off">
                <span class="arch-perm-x" aria-hidden="true"></span>
                <span class="arch-perm-name">Margin</span>
              </div>
              <div class="arch-perm-row arch-perm-off">
                <span class="arch-perm-x" aria-hidden="true"></span>
                <span class="arch-perm-name">Wallet · Transfer</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Frame 1: AES-256-GCM key encryption -->
        <div class="ss-frame ss-frame-1">
          <div class="arch-frame-mock">
            <div class="arch-mock-head">Encrypted at rest</div>
            <div class="arch-crypto">
              <div class="arch-crypto-row">
                <span class="arch-crypto-key">api_key</span>
                <span class="arch-crypto-val arch-crypto-plain">8a3f···c2b9</span>
              </div>
              <div class="arch-crypto-arrow">
                <span class="arch-crypto-cipher">AES-256-GCM</span>
              </div>
              <div class="arch-crypto-row arch-crypto-stored">
                <span class="arch-crypto-key">storage</span>
                <span class="arch-crypto-val">
                  <span class="arch-crypto-mask">██████ ██████ ██████ ██████</span>
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Frame 2: 資金 stays in user's Bitfinex -->
        <div class="ss-frame ss-frame-2">
          <div class="arch-frame-mock arch-flow">
            <div class="arch-flow-row">
              <div class="arch-flow-box arch-flow-user">
                <span class="arch-flow-lbl">你的</span>
                <span class="arch-flow-name">Bitfinex Account</span>
                <span class="arch-flow-sub">資金保管</span>
              </div>
              <svg class="arch-flow-arrow" viewBox="0 0 80 12" aria-hidden="true">
                <path d="M 2 6 L 76 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                <path d="M 68 2 L 76 6 L 68 10" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <div class="arch-flow-box arch-flow-bot">
                <span class="arch-flow-lbl">LendAuto</span>
                <span class="arch-flow-name">Quote Bot</span>
                <span class="arch-flow-sub">只下 funding 單</span>
              </div>
            </div>
            <div class="arch-flow-note">資金永遠在你的帳號，我們僅持有「掛單」這一個動作的權限。</div>
          </div>
        </div>

        <!-- Frame 3: Performance screenshot transparency -->
        <div class="ss-frame ss-frame-3">
          <div class="arch-frame-mock">
            <div class="arch-mock-head">demo 帳號 · 30 日績效</div>
            <div class="arch-perf">
              <svg viewBox="0 0 320 140" preserveAspectRatio="none" aria-hidden="true">
                <defs>
                  <linearGradient id="archPerfFill" x1="0" x2="0" y1="0" y2="1">
                    <stop offset="0%" stop-color="currentColor" stop-opacity="0.30" />
                    <stop offset="100%" stop-color="currentColor" stop-opacity="0" />
                  </linearGradient>
                </defs>
                <path
                  d="M 0 110 Q 30 100 60 95 T 110 75 T 160 60 T 210 50 T 260 30 T 320 25 L 320 140 L 0 140 Z"
                  fill="url(#archPerfFill)"
                  class="arch-perf-fill"
                />
                <path
                  d="M 0 110 Q 30 100 60 95 T 110 75 T 160 60 T 210 50 T 260 30 T 320 25"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  class="arch-perf-line"
                />
              </svg>
              <div class="arch-perf-foot">
                <span class="arch-perf-foot-lbl">Apr 18 — May 18</span>
                <span class="arch-perf-foot-val">+ 8.42 %</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <StickyScrollStage client:load />
</section>

<style>
  .arch-section {
    background: var(--color-surface);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    padding: 0;
  }
  .arch-wrap {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .arch-left { padding: 96px 0 120px; }
  .arch-header { margin-bottom: 48px; }
  .arch-title {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.030em;
    color: var(--color-ink);
    margin: 0 0 18px;
  }
  .arch-lede {
    font-size: 17px;
    line-height: 1.65;
    color: var(--color-ink-soft);
    max-width: 480px;
    margin: 0;
  }

  .ss-step {
    min-height: 78vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 28px 0;
    border-top: 1px solid var(--color-line-soft);
  }
  .ss-step .stepnum {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-mute);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .ss-step h3 {
    font-family: var(--font-display);
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.15;
    letter-spacing: -0.022em;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 14px;
  }
  .ss-step p {
    color: var(--color-ink-soft);
    font-size: 16px;
    line-height: 1.65;
    max-width: 440px;
    margin: 0 0 18px;
  }
  .arch-tag {
    align-self: flex-start;
    padding: 4px 10px;
    border-radius: 6px;
    background: color-mix(in srgb, var(--color-ink) 5%, transparent);
    color: var(--color-mute);
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.03em;
  }

  .arch-right {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ss-stage {
    position: relative;
    width: 100%;
    max-width: 460px;
    aspect-ratio: 1;
    background:
      radial-gradient(ellipse 70% 50% at 30% 20%, color-mix(in srgb, var(--color-brand) 14%, transparent), transparent 60%),
      radial-gradient(ellipse 60% 50% at 80% 90%, color-mix(in srgb, var(--color-coral) 12%, transparent), transparent 60%),
      linear-gradient(160deg, var(--color-bg), var(--color-bg-soft));
    border: 1px solid var(--color-line);
    border-radius: 24px;
    overflow: hidden;
    box-shadow:
      0 30px 60px -20px rgba(10, 37, 64, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }
  .ss-stage::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 110%, transparent 55%, rgba(10, 37, 64, 0.05) 100%);
    pointer-events: none;
  }
  .ss-frame {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 500ms var(--ease-out-expo),
                transform 500ms var(--ease-out-expo);
    transform: translateY(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 36px;
    pointer-events: none;
  }
  .ss-frame.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  /* ── Shared mock card ──────────────────────────────────────────── */
  .arch-frame-mock {
    width: 100%;
    background: var(--color-surface);
    border-radius: 14px;
    border: 1px solid var(--color-line);
    padding: 20px 22px;
    box-shadow: 0 10px 30px -10px rgba(10, 37, 64, 0.10);
  }
  .arch-mock-head {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-mute);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding-bottom: 12px;
    margin-bottom: 14px;
    border-bottom: 1px solid var(--color-line-soft);
  }

  /* ── Frame 0: permission toggles ───────────────────────────────── */
  .arch-perm { display: flex; flex-direction: column; gap: 10px; }
  .arch-perm-row {
    display: flex; align-items: center; gap: 12px;
    padding: 11px 14px;
    border-radius: 10px;
    background: var(--color-bg);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .arch-perm-name { color: var(--color-ink-soft); }
  .arch-perm-tick, .arch-perm-x {
    width: 18px; height: 18px;
    border-radius: 5px;
    flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
  }
  .arch-perm-on { background: color-mix(in srgb, var(--color-mint) 8%, transparent); }
  .arch-perm-on .arch-perm-name { color: var(--color-ink); font-weight: 500; }
  .arch-perm-tick {
    background: var(--color-mint);
    position: relative;
  }
  .arch-perm-tick::after {
    content: '';
    width: 10px; height: 5px;
    border-left: 2px solid #fff;
    border-bottom: 2px solid #fff;
    transform: translateY(-1px) rotate(-45deg);
  }
  .arch-perm-x {
    background: color-mix(in srgb, var(--color-mute) 18%, transparent);
    color: var(--color-mute);
    position: relative;
  }
  .arch-perm-x::before,
  .arch-perm-x::after {
    content: '';
    position: absolute;
    width: 10px; height: 1.6px;
    background: var(--color-mute);
  }
  .arch-perm-x::before { transform: rotate(45deg); }
  .arch-perm-x::after  { transform: rotate(-45deg); }
  .arch-perm-off .arch-perm-name { color: var(--color-mute); }

  /* ── Frame 1: crypto flow ───────────────────────────────────────── */
  .arch-crypto { display: flex; flex-direction: column; gap: 10px; align-items: stretch; }
  .arch-crypto-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 14px;
    border-radius: 10px;
    background: var(--color-bg);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .arch-crypto-key { color: var(--color-mute); letter-spacing: 0.04em; }
  .arch-crypto-val { color: var(--color-ink); font-weight: 500; }
  .arch-crypto-plain { color: var(--color-coral); }
  .arch-crypto-mask {
    color: var(--color-brand);
    letter-spacing: 0.10em;
    font-size: 12px;
  }
  .arch-crypto-arrow {
    display: flex; justify-content: center;
    position: relative;
    padding: 4px 0;
  }
  .arch-crypto-arrow::before {
    content: '';
    position: absolute;
    top: 0; bottom: 0; left: 50%;
    width: 1px;
    background: color-mix(in srgb, var(--color-brand) 35%, transparent);
  }
  .arch-crypto-cipher {
    position: relative;
    padding: 4px 12px;
    background: color-mix(in srgb, var(--color-brand) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-brand) 30%, transparent);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--color-brand);
    letter-spacing: 0.06em;
  }
  .arch-crypto-stored .arch-crypto-key { color: var(--color-mint); }

  /* ── Frame 2: flow diagram ──────────────────────────────────────── */
  .arch-flow { padding: 22px; }
  .arch-flow-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
  }
  .arch-flow-box {
    padding: 16px 14px;
    border-radius: 10px;
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    text-align: center;
    display: flex; flex-direction: column; gap: 4px;
  }
  .arch-flow-bot {
    background: color-mix(in srgb, var(--color-brand) 6%, var(--color-surface));
    border-color: color-mix(in srgb, var(--color-brand) 30%, transparent);
  }
  .arch-flow-lbl {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-mute);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .arch-flow-bot .arch-flow-lbl { color: var(--color-brand); }
  .arch-flow-name {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-ink);
    font-size: 13.5px;
    white-space: nowrap;
  }
  .arch-flow-sub {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-mute);
    white-space: nowrap;
  }
  .arch-flow-arrow {
    width: 80px;
    height: 12px;
    color: var(--color-brand);
  }
  .arch-flow-note {
    margin-top: 18px;
    text-align: center;
    font-size: 12.5px;
    color: var(--color-mute);
    line-height: 1.55;
  }

  /* ── Frame 3: performance graph ─────────────────────────────────── */
  .arch-perf { color: var(--color-brand); }
  .arch-perf svg { width: 100%; height: 140px; display: block; }
  .arch-perf-foot {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--color-line-soft);
  }
  .arch-perf-foot-lbl {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-mute);
    letter-spacing: 0.06em;
  }
  .arch-perf-foot-val {
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 700;
    color: var(--color-mint);
    letter-spacing: -0.01em;
  }

  /* ── Responsive ─────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .arch-wrap {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .arch-left { padding: 64px 0 80px; }
    .ss-step { min-height: auto; padding: 24px 0; }
    .arch-right {
      position: relative;
      height: auto;
      padding: 20px 0 60px;
    }
    .ss-stage { aspect-ratio: 1.2; max-width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ss-frame { transition: opacity 0ms; transform: none; }
  }
</style>
