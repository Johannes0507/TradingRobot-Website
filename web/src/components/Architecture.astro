---
const pillars = [
  {
    n: '01',
    title: 'API 權限只勾 Funding',
    desc: '你在 Bitfinex 生成 API Key 時，只勾 Funding scope，不勾 Withdrawals 與 Trading。Bitfinex 端強制執行，LendAuto 後端即使有 key 也無法繞過。',
    tag: 'scope: funding_only',
  },
  {
    n: '02',
    title: 'AES-256-GCM 加密儲存',
    desc: 'API Key 在資料庫是密文，envelope encryption + per-tenant key。LendAuto 工程師也看不到明文。',
    tag: 'AES-256-GCM · envelope',
  },
  {
    n: '03',
    title: '資金永遠在你的 Bitfinex 帳號',
    desc: 'LendAuto 是掛單代理人，不是 custodian。我們不開錢包、不持有資產、不經手任何提款。',
    tag: 'custody: self',
  },
];
---

<section id="security" class="py-[56px] lg:py-[96px] relative">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] gap-10 lg:gap-14 items-start">
      <!-- Left: sticky headline -->
      <div class="lg:sticky lg:top-32">
        <div class="eyebrow text-xs font-mono font-semibold text-brand uppercase tracking-wider mb-4">
          架構與安全
        </div>
        <h2
          class="text-4xl lg:text-5xl font-display font-bold text-ink leading-[1.1] tracking-tight mb-6"
        >
          你的錢，<br />我們從來<br />沒碰過。
        </h2>
        <p class="text-lg text-ink-soft mb-7">
          把自動化交給我們，把保管留給你自己。三個技術約束讓「我們即使想拿也拿不到」。
        </p>
      </div>

      <!-- Right: diagram + pillars + screenshot -->
      <div class="flex flex-col gap-7">
        <!-- Architecture diagram -->
        <div class="p-7 rounded-2xl bg-bg-soft border border-line-soft">
          <div class="text-xs font-mono text-mute uppercase tracking-wider mb-5">
            資料流架構
          </div>
          <svg viewBox="0 0 720 280" class="w-full h-auto arch-svg" role="img" aria-label="LendAuto 系統架構圖">
            <!-- Boxes -->
            <g font-family="JetBrains Mono, monospace" font-size="13">
              <!-- User -->
              <rect x="20" y="50" width="160" height="80" rx="12" class="arch-bg" />
              <text x="100" y="80" text-anchor="middle" font-weight="700" class="arch-ink">你的 Bitfinex</text>
              <text x="100" y="100" text-anchor="middle" font-weight="700" class="arch-ink">Account</text>
              <text x="100" y="118" text-anchor="middle" font-size="11" class="arch-mute">資金 custody</text>

              <!-- LendAuto Server -->
              <rect x="280" y="50" width="160" height="80" rx="12" class="arch-bg arch-brand-stroke" />
              <text x="360" y="80" text-anchor="middle" font-weight="700" class="arch-brand">LendAuto</text>
              <text x="360" y="100" text-anchor="middle" font-weight="700" class="arch-brand">Server</text>
              <text x="360" y="118" text-anchor="middle" font-size="11" class="arch-mute">掛單代理</text>

              <!-- Bitfinex API -->
              <rect x="540" y="50" width="160" height="80" rx="12" class="arch-bg" />
              <text x="620" y="80" text-anchor="middle" font-weight="700" class="arch-ink">Bitfinex</text>
              <text x="620" y="100" text-anchor="middle" font-weight="700" class="arch-ink">Funding API</text>
              <text x="620" y="118" text-anchor="middle" font-size="11" class="arch-mute">scope: funding</text>

              <!-- Encrypted key box -->
              <rect x="280" y="180" width="160" height="60" rx="12" class="arch-amber-bg" />
              <text x="360" y="205" text-anchor="middle" font-weight="700" class="arch-amber">加密的 API Key</text>
              <text x="360" y="225" text-anchor="middle" font-size="11" class="arch-mute">AES-256-GCM · 只能掛 funding 單</text>

              <!-- Forbidden withdrawal -->
              <text x="100" y="200" text-anchor="middle" font-weight="700" class="arch-danger">提款路徑</text>
              <text x="100" y="220" text-anchor="middle" font-size="11" class="arch-danger">✗ 不存在</text>
            </g>

            <!-- Arrows -->
            <g stroke-width="2" fill="none" class="arch-arrow">
              <!-- User <-> Server (top) -->
              <path d="M 180 90 L 280 90" marker-end="url(#arrow)" />
              <!-- Server <-> Bitfinex API (top) -->
              <path d="M 440 90 L 540 90" marker-end="url(#arrow)" />
              <!-- Server uses encrypted key -->
              <path d="M 360 130 L 360 180" class="arch-amber-stroke" />
            </g>

            <!-- No-path X arrow from user to "提款路徑" -->
            <g stroke-width="2" fill="none" stroke-dasharray="6 4" class="arch-danger-stroke">
              <path d="M 100 130 L 100 175" />
            </g>

            <defs>
              <marker id="arrow" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="6" markerHeight="6" orient="auto">
                <path d="M 0 0 L 10 5 L 0 10 z" class="arch-arrow-head" />
              </marker>
            </defs>
          </svg>
          <p class="text-xs text-mute font-mono mt-4 leading-relaxed">
            紅色虛線：API Key 上根本沒有 Withdrawal 權限，這條路徑在 Bitfinex 平台層就被擋掉，LendAuto 端再怎麼想也無法觸發。
          </p>
        </div>

        <!-- 3 pillar cards -->
        <div class="flex flex-col gap-4">
          {
            pillars.map((p) => (
              <div class="p-7 rounded-2xl bg-bg border border-line-soft flex gap-5 items-start shadow-sm">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-ink to-ink-soft text-white flex items-center justify-center flex-shrink-0 font-mono font-bold">
                  {p.n}
                </div>
                <div class="flex-1">
                  <h3 class="text-lg font-display font-bold text-ink mb-2 tracking-tight">
                    {p.title}
                  </h3>
                  <p class="text-[15px] text-ink-soft leading-relaxed mb-3">{p.desc}</p>
                  <div class="inline-block px-2.5 py-1.5 rounded-md font-mono text-xs text-ink-soft bg-line-soft">
                    {p.tag}
                  </div>
                </div>
              </div>
            ))
          }
        </div>

        <!-- Static performance screenshot slot -->
        <div class="p-7 rounded-2xl bg-bg-soft border border-line-soft">
          <div class="text-xs font-mono text-mute uppercase tracking-wider mb-3">
            績效樣張
          </div>
          <h3 class="text-lg font-display font-bold text-ink mb-3 tracking-tight">
            LendAuto 在 demo 帳號跑 30 日的實際表現
          </h3>
          <img
            src="/screenshots/demo-performance-placeholder.svg"
            alt="LendAuto demo account 30 日績效截圖（placeholder，待真實資料更新）"
            class="w-full max-h-[360px] object-contain rounded-xl border border-line-soft bg-bg"
            loading="lazy"
            decoding="async"
            width="1200"
            height="600"
          />
          <p class="text-xs text-mute font-mono mt-4 leading-relaxed">
            截圖內容無美化、無修圖、無剪輯。累積一段時間後會增加更多時間範圍的截圖。
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Architecture SVG — token-driven fills/strokes (no hard-coded hex) */
  .arch-svg .arch-bg          { fill: var(--color-bg);     stroke: color-mix(in srgb, var(--color-ink) 8%, transparent); }
  .arch-svg .arch-ink         { fill: var(--color-ink); }
  .arch-svg .arch-mute        { fill: var(--color-mute); }
  .arch-svg .arch-brand       { fill: var(--color-brand); }
  .arch-svg .arch-brand-stroke{ stroke: color-mix(in srgb, var(--color-brand) 25%, transparent); }
  .arch-svg .arch-amber       { fill: var(--color-amber); }
  .arch-svg .arch-amber-bg    { fill: color-mix(in srgb, var(--color-amber) 8%, transparent);
                                 stroke: color-mix(in srgb, var(--color-amber) 25%, transparent); }
  .arch-svg .arch-amber-stroke{ stroke: color-mix(in srgb, var(--color-amber) 50%, transparent); }
  .arch-svg .arch-danger      { fill: var(--color-danger); }
  .arch-svg .arch-danger-stroke { stroke: var(--color-danger); }
  .arch-svg .arch-arrow       { stroke: color-mix(in srgb, var(--color-ink) 25%, transparent); }
  .arch-svg .arch-arrow-head  { fill: color-mix(in srgb, var(--color-ink) 50%, transparent); }
</style>
