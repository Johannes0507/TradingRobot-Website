---
import LumenMesh from './islands/LumenMesh.tsx';
import HeroPanel from './islands/HeroPanel.tsx';
import { subscribeUrl } from '../lib/cta';
---

<section class="relative pt-[112px] lg:pt-[140px] pb-[80px] lg:pb-[100px] overflow-hidden">
  <!-- Background: WebGL animated mesh (desktop/tablet only).
       Custom palette — soft cream → lavender → pink → peach.
       Low amplitude so it stays gentle behind the text. -->
  <div
    aria-hidden="true"
    class="hidden md:block absolute inset-0 pointer-events-none z-0 hero-mesh-frame"
  >
    <LumenMesh
      client:only="react"
      segments={70}
      amplitude={0.28}
      speed={0.85}
      freq1={1.6}
      freq2={2.4}
      freq3={3.2}
      darkenTop={0.05}
      style={{
        '--gradientcolorzero': '#fbfafe',
        '--gradientcolorone': '#dfe4ff',
        '--gradientcolortwo': '#ffd9eb',
        '--gradientcolorthree': '#ffe8d4',
      } as any}
    />
    <!-- Left-edge fade so headline area stays clean -->
    <div class="hero-mesh-fade" aria-hidden="true"></div>
  </div>

  <!-- Content grid -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-12 lg:gap-14 items-center">
      <!-- Left: copy -->
      <div>
        <!-- Eyebrow — muted mono label, brand reserved for interactive -->
        <div class="eyebrow text-xs font-mono font-semibold text-mute uppercase tracking-[0.14em] mb-7">
          Bitfinex · Funding Automation
        </div>

        <!-- Headline — pure ink (Stripe-style); brand reserved for links/icons -->
        <h1
          class="font-display font-bold text-ink tracking-tight mb-6"
          style="font-size: clamp(30px, 3.6vw, 48px); line-height: 1.12;"
        >
          <span class="whitespace-nowrap">把 Bitfinex funding 報價</span><br />
          交給機器人，<span class="whitespace-nowrap">24 × 60 × 60 秒</span>盯著。
        </h1>

        <!-- Lede — tightened to one line of value prop -->
        <p class="text-lg lg:text-xl text-ink-soft leading-relaxed mb-10 max-w-xl">
          每 30 秒重新評估市場、依資金量分層報價，每日結算入帳。
        </p>

        <!-- CTAs — primary solid + secondary ghost link -->
        <div class="flex flex-wrap items-center gap-2">
          <a
            href={subscribeUrl({ source: 'hero' })}
            class="inline-flex items-center justify-center gap-1.5 px-5 py-2.5 rounded-md bg-ink text-white font-medium hover:bg-ink-soft transition-colors"
          >
            開始使用
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
              <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a
            href="/guides/bitfinex-api-setup"
            class="inline-flex items-center gap-1 px-3 py-2.5 rounded-md text-ink-soft font-medium hover:text-ink transition-colors"
          >
            先看設定教學
            <svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true" class="opacity-60">
              <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right: holographic card + floating live ticker -->
      <div class="hidden lg:block">
        <HeroPanel client:visible />
      </div>
    </div>
  </div>
</section>
