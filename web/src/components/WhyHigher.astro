---
const features = [
  {
    title: '智能追蹤市場利率',
    desc: '自動跟隨 Bitfinex Flash Return Rate 浮動，市場利率變動時即時更新報價。',
    tech: 'FRR Delta Var · FRR Delta Fix',
    tint: 'brand',
  },
  {
    title: '預埋高利率訂單，市場波動時自動成交',
    desc: '階梯式部署多檔高利率訂單。當市場資金短缺、利率瞬時抬升時，預埋單會被自動成交。',
    tech: 'Spike Catching · 階梯式網格',
    tint: 'coral',
  },
  {
    title: '毫秒級執行',
    desc: 'Go 語言寫的引擎，24 小時不停偵測、不停調倉。',
    tech: 'Go 1.26 · WebSocket 即時連線',
    tint: 'mint',
  },
];

const tintMap: Record<string, { bg: string; text: string; gradient: string }> = {
  brand: { bg: 'bg-brand/10', text: 'text-brand', gradient: 'from-brand to-brand/70' },
  coral: { bg: 'bg-coral/10', text: 'text-coral', gradient: 'from-coral to-coral/70' },
  mint:  { bg: 'bg-mint/10',  text: 'text-mint',  gradient: 'from-mint to-mint/70' },
};
---

<section id="why" class="py-[56px] lg:py-[96px] bg-bg-soft relative overflow-hidden">
  <!-- Subtle radial mesh -->
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[400px] pointer-events-none"
    style="background: radial-gradient(ellipse, rgb(99 91 255 / 0.08) 0%, transparent 70%);"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-12">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="eyebrow text-xs font-mono font-semibold text-brand uppercase tracking-wider mb-4">
        為什麼報酬更高
      </div>
      <h2 class="text-4xl lg:text-5xl font-display font-bold text-ink leading-[1.1] tracking-tight mb-5">
        手動掛 1-2 次，<br />
        bot 每 <span class="text-brand">30 秒</span> 重新評估
      </h2>
      <p class="text-lg text-ink-soft">
        三個技術差異，把手動放貸的盲點補起來。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {
        features.map((f) => {
          const tint = tintMap[f.tint];
          return (
            <div class="relative p-8 rounded-xl bg-bg border border-line-soft overflow-hidden group hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
              <div
                class="absolute -top-10 -right-10 w-40 h-40 rounded-full pointer-events-none opacity-50 group-hover:opacity-80 transition-opacity"
                style={`background: radial-gradient(circle, ${f.tint === 'brand' ? '#635bff' : f.tint === 'coral' ? '#ff7eb6' : '#14d9a8'}20 0%, transparent 70%);`}
              />
              <div
                class={`relative w-13 h-13 w-[52px] h-[52px] rounded-xl bg-gradient-to-br ${tint.gradient} flex items-center justify-center text-white mb-5 shadow-lg`}
              >
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M3 3v18h18" />
                  <path d="m7 14 4-4 4 4 5-5" />
                </svg>
              </div>
              <h3 class="relative text-xl font-display font-bold text-ink mb-2.5 tracking-tight">
                {f.title}
              </h3>
              <p class="relative text-[15px] text-ink-soft leading-relaxed mb-4">{f.desc}</p>
              <div class={`relative inline-block px-2.5 py-1.5 rounded-md font-mono text-[11px] font-semibold ${tint.bg} ${tint.text}`}>
                {f.tech}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
