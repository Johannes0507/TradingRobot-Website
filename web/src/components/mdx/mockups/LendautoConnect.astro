---
/**
 * LendautoConnect.astro — mockup of LendAuto app's "Connect Bitfinex" screen.
 *
 * Brand-aligned (light theme + purple accents) to contrast with the dark
 * Bitfinex mockups — visually signals "you're now back on LendAuto".
 */
---

<svg
  viewBox="0 0 1200 440"
  class="block w-full h-auto"
  role="img"
  aria-label="LendAuto 應用程式內的 Bitfinex 連結畫面示意。貼上 Key 與 Secret，按驗證連結。"
>
  <!-- Light background (LendAuto theme) -->
  <rect x="0" y="0" width="1200" height="440" fill="#ffffff" />

  <!-- LendAuto app side panel -->
  <rect x="0" y="0" width="220" height="440" fill="#fafafa" />

  <g transform="translate(24, 36)">
    <!-- LendAuto logo -->
    <rect x="0" y="0" width="28" height="28" rx="6" fill="#635bff" />
    <text x="40" y="20" font-family="Inter, sans-serif" font-size="16" font-weight="700" fill="#1a1f36">LendAuto</text>

    <!-- Nav -->
    <g transform="translate(0, 56)" font-family="Inter, sans-serif" font-size="13">
      <text y="0" fill="#6b7280">Dashboard</text>
      <text y="32" fill="#6b7280">策略</text>
      <text y="64" fill="#6b7280">配息歷史</text>

      <!-- Active -->
      <rect x="-8" y="80" width="180" height="32" rx="6" fill="#635bff" fill-opacity="0.1" />
      <text y="100" font-weight="700" fill="#635bff">設定</text>

      <text y="132" fill="#6b7280">帳號</text>
    </g>
  </g>

  <!-- Main panel -->
  <g transform="translate(260, 40)">
    <text font-family="Inter, sans-serif" font-size="11" font-weight="600" fill="#635bff" letter-spacing="1.5">SETTINGS · BITFINEX 連結</text>
    <text y="32" font-family="Inter, sans-serif" font-size="24" font-weight="700" fill="#1a1f36">連結 Bitfinex 帳戶</text>
    <text y="56" font-family="Inter, sans-serif" font-size="13" fill="#6b7280">把剛才從 Bitfinex 複製的 Key 與 Secret 貼到下方。</text>

    <!-- Key input -->
    <g transform="translate(0, 92)">
      <text font-family="Inter, sans-serif" font-size="11" font-weight="600" fill="#1a1f36" letter-spacing="0.5">API KEY</text>
      <rect x="0" y="14" width="700" height="44" rx="8" fill="#fafafa" stroke="#1a1f3614" stroke-width="1.5" />
      <text x="16" y="42" font-family="JetBrains Mono, monospace" font-size="13" fill="#1a1f36">abc1234…XyZ789</text>
    </g>

    <!-- Secret input -->
    <g transform="translate(0, 168)">
      <text font-family="Inter, sans-serif" font-size="11" font-weight="600" fill="#1a1f36" letter-spacing="0.5">API SECRET</text>
      <rect x="0" y="14" width="700" height="44" rx="8" fill="#fafafa" stroke="#1a1f3614" stroke-width="1.5" />
      <text x="16" y="42" font-family="JetBrains Mono, monospace" font-size="13" fill="#6b7280">••••••••••••••••</text>

      <text x="0" y="76" font-family="Inter, sans-serif" font-size="11" fill="#6b7280">儲存後即加密，連我們工程師也看不到明文。</text>
    </g>

    <!-- Verify button -->
    <g transform="translate(0, 280)">
      <rect x="0" y="0" width="156" height="44" rx="8" fill="#1a1f36" />
      <text x="78" y="28" text-anchor="middle" font-family="Inter, sans-serif" font-size="13" font-weight="600" fill="#ffffff">驗證連結 →</text>

      <text x="172" y="28" font-family="Inter, sans-serif" font-size="12" fill="#10b981" font-weight="600">點下後立刻發測試請求</text>
    </g>
  </g>

  <!-- Annotation -->
  <g>
    <circle cx="978" cy="306" r="18" fill="#fb7185" />
    <text x="978" y="312" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="14" font-weight="700" fill="#ffffff">6</text>

    <g transform="translate(1004, 270)">
      <rect x="0" y="0" width="160" height="68" rx="8" fill="#ffffff" stroke="#1a1f3614" />
      <text x="80" y="22" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" font-weight="700" fill="#fb7185">最後一步</text>
      <text x="80" y="40" text-anchor="middle" font-family="Inter, sans-serif" font-size="10" fill="#1a1f36">貼好兩串 → 驗證</text>
      <text x="80" y="56" text-anchor="middle" font-family="Inter, sans-serif" font-size="10" fill="#1a1f36">通過即完成設定</text>
    </g>
  </g>
</svg>
