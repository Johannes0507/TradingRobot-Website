---
/**
 * BitfinexApiPage.astro — mockup of Bitfinex API management page.
 *
 * Shows the page title, an empty key list, and the "+ Create New Key"
 * button highlighted as the next action.
 */
---

<svg
  viewBox="0 0 1200 480"
  class="block w-full h-auto"
  role="img"
  aria-label="Bitfinex API 管理頁示意，右上角有 Create New Key 按鈕，點下後展開權限面板"
>
  <!-- Sidebar -->
  <rect x="0" y="0" width="220" height="480" fill="#0a0e1a" />

  <g font-family="Inter, sans-serif" font-size="12" fill="#ffffff">
    <text x="20" y="32" font-size="10" opacity="0.4" font-weight="700" letter-spacing="1.5">ACCOUNT</text>
    <text x="20" y="58" opacity="0.6">Profile</text>
    <text x="20" y="84" opacity="0.6">Security</text>
    <text x="20" y="110" opacity="0.6">Wallets</text>

    <!-- Active item -->
    <rect x="8" y="124" width="204" height="32" rx="6" fill="#1f2738" />
    <text x="20" y="144" font-weight="700">API</text>

    <text x="20" y="174" opacity="0.6">Sub-Accounts</text>
    <text x="20" y="200" opacity="0.6">Notifications</text>

    <text x="20" y="240" font-size="10" opacity="0.4" font-weight="700" letter-spacing="1.5">SUPPORT</text>
    <text x="20" y="266" opacity="0.6">Help</text>
    <text x="20" y="292" opacity="0.6">Verification</text>
  </g>

  <!-- Main content area background -->
  <rect x="220" y="0" width="980" height="480" fill="#0d1018" />

  <!-- Title -->
  <text x="260" y="58" font-family="Inter, sans-serif" font-size="22" font-weight="700" fill="#ffffff">API Keys</text>
  <text x="260" y="80" font-family="Inter, sans-serif" font-size="12" fill="#ffffff" opacity="0.55">Manage API keys for third-party applications.</text>

  <!-- Create New Key button (top right of main area) -->
  <g transform="translate(1020, 42)">
    <rect x="0" y="0" width="148" height="36" rx="6" fill="#9be37e" />
    <text x="74" y="23" text-anchor="middle" font-family="Inter, sans-serif" font-size="13" font-weight="700" fill="#0a0e1a">+ Create New Key</text>
  </g>

  <!-- Empty key list area -->
  <g transform="translate(260, 110)">
    <!-- Headers -->
    <rect x="0" y="0" width="900" height="40" rx="6" fill="#161a26" />
    <g font-family="Inter, sans-serif" font-size="11" font-weight="600" fill="#ffffff" opacity="0.55" letter-spacing="0.5">
      <text x="20" y="25">LABEL</text>
      <text x="240" y="25">KEY</text>
      <text x="540" y="25">PERMISSIONS</text>
      <text x="720" y="25">CREATED</text>
      <text x="850" y="25">STATUS</text>
    </g>

    <!-- Empty state -->
    <g transform="translate(0, 60)">
      <rect x="0" y="0" width="900" height="200" rx="10" fill="#0d1018" stroke="#ffffff" stroke-opacity="0.06" stroke-dasharray="6 6" />
      <text x="450" y="92" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="#ffffff" opacity="0.65">尚未建立任何 API Key</text>
      <text x="450" y="115" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill="#ffffff" opacity="0.4">點右上角「+ Create New Key」開始</text>
    </g>
  </g>

  <!-- Annotation -->
  <g>
    <!-- Numbered callout -->
    <circle cx="1004" cy="60" r="18" fill="#fb7185" />
    <text x="1004" y="66" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="14" font-weight="700" fill="#ffffff">2</text>

    <!-- Highlight ring around button -->
    <rect x="1018" y="40" width="152" height="40" rx="8" fill="none" stroke="#fb7185" stroke-width="2.5" stroke-dasharray="4 4" />

    <!-- Label -->
    <g transform="translate(850, 122)">
      <path d="M 168 -42 q 0 -8 8 -8 h 138 q 8 0 8 8 v 50 q 0 8 -8 8 h -100 l -10 14 l 0 -14 h -28 q -8 0 -8 -8 z" fill="#ffffff" />
      <text x="248" y="-22" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" font-weight="700" fill="#fb7185">點這個按鈕</text>
      <text x="248" y="-4" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="#1a1f36">會開啟權限設定面板</text>
    </g>
  </g>
</svg>
