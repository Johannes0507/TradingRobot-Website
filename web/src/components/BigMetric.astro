---
/**
 * BigMetric — Stripe/Lumen-style oversized statistic showcase.
 *
 * Uses one DOMINANT number to anchor the page, with supporting
 * secondary metrics below in a 4-col row.
 *
 * Reference: Lumen's metrics section — large gradient-faded number
 * for visual hierarchy + 4 smaller metrics in a row.
 */
import Counter from './islands/Counter.tsx';
import { MARKET_DATA } from '../lib/mock-data';
---

<section
  aria-labelledby="bigmetric-heading"
  class="relative py-24 lg:py-36 text-center overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-12 relative">
    <h2 id="bigmetric-heading" class="sr-only">關鍵指標</h2>

    <!-- Eyebrow -->
    <div class="eyebrow text-xs font-mono font-semibold text-mute uppercase tracking-wider mb-8 justify-center">
      Bitfinex Funding · 30 日數據
    </div>

    <!-- Hero number with gradient fade -->
    <p class="bigmetric-hero font-display font-bold leading-[0.92] tracking-[-0.045em] m-0">
      <Counter
        client:visible
        to={MARKET_DATA.fusd30dAvgApr}
        decimals={2}
        suffix="%"
      />
    </p>

    <p class="text-base lg:text-lg text-ink-soft mt-5 max-w-xl mx-auto leading-relaxed">
      過去 30 日 fUSD 平均年化利率。市場已經夠好了，我們要做的，是讓你每分每秒都拿得到這個數字。
    </p>

    <!-- Supporting metrics -->
    <div class="mt-20 lg:mt-24 grid grid-cols-2 lg:grid-cols-4 gap-y-10 gap-x-8 text-left max-w-5xl mx-auto">
      <div>
        <p class="font-display font-bold text-3xl lg:text-4xl text-ink leading-none tracking-tight font-mono">
          <Counter client:visible to={30} suffix="s" />
        </p>
        <p class="mt-2.5 text-sm text-mute leading-snug">每 30 秒重新評估市場、調整報價</p>
      </div>
      <div>
        <p class="font-display font-bold text-3xl lg:text-4xl text-ink leading-none tracking-tight font-mono">
          24/7
        </p>
        <p class="mt-2.5 text-sm text-mute leading-snug">全年無休，無需手動介入</p>
      </div>
      <div>
        <p class="font-display font-bold text-3xl lg:text-4xl text-ink leading-none tracking-tight font-mono">
          <Counter client:visible to={MARKET_DATA.fusd30dHighApr} decimals={1} suffix="%" />
        </p>
        <p class="mt-2.5 text-sm text-mute leading-snug">過去 30 日 fUSD 利率高點，bot 跟得上 spike</p>
      </div>
      <div>
        <p class="font-display font-bold text-3xl lg:text-4xl text-ink leading-none tracking-tight font-mono">
          3
        </p>
        <p class="mt-2.5 text-sm text-mute leading-snug">非託管設計、僅 funding 權限、無提款能力</p>
      </div>
    </div>
  </div>

  <!-- Soft radial halo behind for depth -->
  <div
    aria-hidden="true"
    class="absolute inset-0 pointer-events-none -z-10"
    style="background: radial-gradient(ellipse 60% 50% at 50% 35%, color-mix(in srgb, var(--color-brand) 8%, transparent), transparent 70%);"
  ></div>
</section>

<style>
  .bigmetric-hero {
    font-size: clamp(72px, 14vw, 200px);
    background: linear-gradient(180deg, var(--color-ink) 25%, color-mix(in srgb, var(--color-ink) 5%, transparent) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
</style>
